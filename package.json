{
  "name": "thread5-storefront",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && rm -rf .next/standalone/.next/static && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "gates": "python3 tools/gates.py",
    "lint": "eslint .",
    "oracle:vectors": "bun tools/make_oracle_vectors.ts",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "taste": "python3 tools/taste.py",
    "test": "bun test tests/unit",
    "test:py": "python3 -m unittest discover -s tests/python -v",
    "typecheck": "tsc --noEmit",
    "validate": "python3 tools/validate.py",
    "window": "python3 tools/window.py"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
