#!/usr/bin/env bash
# THREAD 5 — sha-замок квитанций (внешний аудит 2026-10-31, F2/рек. 2)
# + ревизия 2026-11-01 (docs/THREAD5-REVIEW-2026-11-01.md, 1.11):
#   (a) валидатор спек прогоняется ДО гейтов (1.3) — битые specs блокируют
#       коммит, а не выключают гейты молча;
#   (b) untracked-квитанции/отчёты блокируют коммит (1.11a): sha-лок пройдёт,
#       а квитанция не уедет в коммит — проверка git status --porcelain;
#   (c) special/SO-батчи под тем же замком — «все гейты без скидок».
# + ревизия 2026-11-20 (инженерный апгрейд):
#   (d) свежая квитанция выбирается по ИМЕНИ (дата+версия в файле),
#       не по mtime — тронутый старый файл больше не выигрывает гонку;
#   (e) чтение квитанции — с encoding='utf-8' (кириллица в receipts не
#       роняет замок молча на Windows/cp1251);
#   (f) перебор изменённых файлов — построчно (while read), не word-split.
#
# На каждый изменённый батч: гейты должны проходить, а sha256 файла —
# совпадать с последней квитанцией. Несовпадение блокирует коммит:
# перегенерируй квитанцию ТЕМ ЖЕ коммитом:
#
#   python3 tools/gates.py batches/T5-NN.md \
#       --json specs/gate-receipts/<дата>-T5-NN-vNN.json \
#       --md batches/T5-NN.gate-report.md
#
# Установка для клона: bash setup.sh   (git config core.hooksPath .githooks)
# Ревизия 2026-11-23 (хирургия тройного вердикта, 1.13): pre-commit гоняет
# полный прогон — валидатор, тест-горн, unittest печи, bun test прилавка —
# раньше только валидатор + testforge (внешний аудит: «молчаливый разлом
# тестов уезжал в репо под шумок»).
set -u

# (1.3) спеки валидны — иначе гейты молча выключены
if ! python3 tools/validate.py; then
  echo "  ✗ валидатор спек FAIL — коммит заблокирован (ревизия 2026-11-01, 1.3)"
  exit 1
fi

# (1.12) ПРОТОКОЛ «ПРОБЫ И ОШИБОК» (2026-11-22): болванки PROTO-2 в корпусе
# обязаны быть законными — FAIL чека блокирует коммит (муха не еблась:
# битая болванка не может уехать в репо молча)
if ! python3 tools/testforge.py check 2>/dev/null; then
  echo "  ✗ тест-горн: болванки PROTO-2 с нарушениями — коммит заблокирован (ревизия 2026-11-22, 1.12)"
  python3 tools/testforge.py check || true
  exit 1
fi

# (1.13) ПОЛНЫЙ ПРОГОН ПЕРЕД КОММИТОМ (тройной вердикт 2026-11-22, рекомендация
# «Расширить pre-commit: добавить unittest и bun test»): молчаливая поломка
# тестов не может уехать в репо — прогон короткий (печь ~3с, прилавок <1с)
if ! python3 -m unittest discover -s tests/python > /dev/null 2>&1; then
  echo "  ✗ юнит-тесты печи FAIL — прогони подробно: python3 -m unittest discover -s tests/python -v (ревизия 2026-11-23, 1.13)"
  exit 1
fi
echo "  ✓ юнит-тесты печи: PASS"

if command -v bun >/dev/null 2>&1 && [ -d node_modules ]; then
  if ! bun test tests/unit > /dev/null 2>&1; then
    echo "  ✗ юнит-тесты прилавка FAIL — прогони подробно: bun test tests/unit (ревизия 2026-11-23, 1.13)"
    exit 1
  fi
  echo "  ✓ юнит-тесты прилавка: PASS"
else
  echo "  ~ bun/node_modules недоступны — тесты прилавка пропущены (CI поймает)"
fi

# (1.14, тикет #4) ГИГИЕНА КОММИТОВ СПЕК: пробельный чурн в индексе кратно
# больше контента (git -w) — full-file реформат едет в фичевый коммит.
# Ревью/блейм убиты классом волны 1в (7162 строк диффа на 67 контента).
if ! python3 tools/commit_hygiene.py --staged; then
  echo "  ✗ гигиена коммитов: реформат-чурн в specs/ — вынеси в отдельный коммит «format:» (тикет #4)"
  exit 1
fi
echo "  ✓ гигиена коммитов спек: чисто"

changed=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(batches/T5-[0-9]+R?|special/SO-[0-9]+)\.md$' || true)
[ -z "$changed" ] && exit 0

# (1.11a) машинные следы не должны остаться untracked
untracked=$(git status --porcelain | grep -E '^\?\? (specs/gate-receipts/|batches/.*gate-report|special/.*gate-report)' || true)
if [ -n "$untracked" ]; then
  echo "  ✗ untracked машинные файлы — квитанция не уедет в коммит (ревизия 2026-11-01, 1.11):"
  echo "$untracked"
  echo "  → git add их тем же коммитом"
  exit 1
fi

rc=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  echo "гейт-замок: $f"
  if ! python3 tools/gates.py "$f" >/dev/null; then
    echo "  ✗ гейты FAIL на $f — коммит заблокирован"
    rc=1
    continue
  fi
  sha=$(python3 -c 'import hashlib,sys;print(hashlib.sha256(open(sys.argv[1],"rb").read().replace(b"\r\n",b"\n")).hexdigest())' "$f")
  # (тикет #1, 2026-11-28): sha — по LF-канону, как в gates.py; CRLF-чекаут
  # (Windows, autocrlf) не роняет замок — квитанции заперты по LF-канону
  # (d) свежая квитанция — по имени (дата-версия), mtime не участвует
  latest=$(grep -rl "\"batch\": \"$f\"" specs/gate-receipts --include='*.json' 2>/dev/null | sort -V | tail -1)
  if [ -n "$latest" ]; then
    # (e) путь через sys.argv + encoding: кириллица и пробелы не ломают чтение
    rsha=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1],encoding="utf-8"))["sha256"])' "$latest" 2>/dev/null || true)
    if [ -n "$rsha" ] && [ "$rsha" != "$sha" ]; then
      echo "  ✗ sha256 $f ≠ квитанции $latest — перегенерируй квитанцию тем же коммитом"
      rc=1
    else
      echo "  ✓ гейты PASS, sha совпадает с $latest"
    fi
  else
    echo "  ~ квитанции нет (батч до-гейтовый) — sha-сверка пропущена"
  fi
done <<EOF
$changed
EOF
exit $rc
